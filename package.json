{
  "name": "mythconnect-enterprise-crm",
  "version": "2.0.0",
  "description": "Myth Connect.ai - Enterprise Omnichannel Meta & WhatsApp Sales Engine and CRM Platform",
  "private": true,
  "scripts": {
    "postinstall": "npm run install:all",
    "install:all": "npm install --prefix backend-node && npm install --prefix frontend",
